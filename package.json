{
  "name": "automationplatform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:watch": "vitest",
    "migrate": "tsx src/database/migrate.ts",
    "openapi:check": "tsx scripts/check_openapi_contract.ts current",
    "openapi:check:frozen": "tsx scripts/check_openapi_contract.ts frozen --sha256 f7c9dee25e27e51d5d96826273b012bffd0ccf8ca2ce9fd6e8a8def730573a72",
    "verify": "npm run typecheck && npm test && npm run openapi:check",
    "ci": "npm run verify && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "msnodesqlv8": "^5.2.3",
    "mssql": "^12.7.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
