                         "msnodesqlv8":  "^5.2.3",
                         "mssql":  "^12.7.0"
                     },
    "devDependencies":  {
                            "@types/mssql":  "^12.3.0",
                            "@types/node":  "^26.2.0",
                            "tsx":  "^4.23.12",
                            "typescript":  "^7.0.2",
                            "vitest":  "^4.1.10"
                        },
    "engines":  {
