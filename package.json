{
    "name":  "automationplatform",
    "version":  "1.0.0",
    "description":  "",
    "main":  "index.js",
    "scripts":  {
                    "test":  "vitest run --maxWorkers=1 --fileParallelism=false",
                    "dev":  "tsx watch src/server.ts",
                    "start":  "node dist/src/server.js",
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test:watch":  "vitest",
                    "migrate":  "tsx src/database/migrate.ts",
                    "openapi:check":  "tsx scripts/check_openapi_contract.ts current",
                    "openapi:check:frozen":  "tsx scripts/check_openapi_contract.ts frozen --sha256 f7c9dee25e27e51d5d96826273b012bffd0ccf8ca2ce9fd6e8a8def730573a72",
                    "verify":  "npm run typecheck \u0026\u0026 npm test \u0026\u0026 npm run openapi:check",
                    "ci":  "npm run verify \u0026\u0026 npm run build"
                },
    "keywords":  [

                 ],
